# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_menu?schema=public"

# Secret used to sign session JWTs — generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL used to build QR code links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
